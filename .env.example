# Copy to .env.local (Vite loads that automatically, and it's gitignored)
# to point the app at the real backend instead of the built-in mock.

# "false" switches from the mock service to the real FastAPI backend.
# Any other value, or leaving this unset, keeps the mock -- the app
# works with no .env file at all.
VITE_USE_MOCK_API=false

# Base URL of api_service (see backend repo's api_service/README or
# run `uvicorn jde_api_service.main:app --reload --port 8000` from
# api_service/). Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000

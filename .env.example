# Copy to .env.local (Vite loads that automatically, and it's gitignored).
# The real backend is the default; "true" switches to in-browser sample data
# (UI development only, labelled "Demo mode" on every page).
VITE_USE_MOCK_API=false

# Base URL of api_service (see backend repo's api_service/README or
# run `uvicorn jde_api_service.main:app --reload --port 8000` from
# api_service/). Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000
